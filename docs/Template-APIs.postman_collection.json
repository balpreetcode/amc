{
    "info": {
        "_postman_id": "template-apis-collection",
        "name": "Template APIs",
        "description": "API collection for managing workflow templates",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3002",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "1. Get All Templates",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/templates",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "templates"
                    ]
                },
                "description": "Retrieves the complete list of all workflow templates with their full configurations including all nodes."
            },
            "response": []
        },
        {
            "name": "2. Get Template by ID",
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/template/:templateId",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "template",
                        ":templateId"
                    ],
                    "variable": [
                        {
                            "key": "templateId",
                            "value": "template-1768527344216-d5dd6a9c",
                            "description": "The unique template ID"
                        }
                    ]
                },
                "description": "Retrieves complete details of a single workflow template including all nodes and their configurations in JSON format."
            },
            "response": []
        },
        {
            "name": "3. Create New Template",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"My Video Workflow\",\n  \"description\": \"A workflow to generate AI videos\",\n  \"nodes\": [\n    {\n      \"id\": \"node-1\",\n      \"type\": \"text_to_text\",\n      \"title\": \"Generate Story\",\n      \"config\": {\n        \"prompt\": \"Write a short story about nature\",\n        \"temperature\": 0.7\n      },\n      \"execution\": {\n        \"mode\": \"parallel\",\n        \"waitForAll\": true\n      }\n    },\n    {\n      \"id\": \"node-2\",\n      \"type\": \"text_to_image\",\n      \"title\": \"Generate Image\",\n      \"config\": {\n        \"prompt\": {\n          \"_type\": \"reference\",\n          \"nodeId\": \"node-1\",\n          \"outputKey\": \"text\"\n        },\n        \"aspectRatio\": \"16:9\"\n      }\n    }\n  ],\n  \"videoPreview\": \"\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/template",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "template"
                    ]
                },
                "description": "Creates a new workflow template by providing a template name and the complete JSON configuration of all nodes."
            },
            "response": []
        },
        {
            "name": "4. Update Template",
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Updated Template Name\",\n  \"description\": \"Updated description\",\n  \"nodes\": [\n    {\n      \"id\": \"node-1\",\n      \"type\": \"text_to_text\",\n      \"title\": \"Generate Story\",\n      \"config\": {\n        \"prompt\": \"Updated prompt\",\n        \"temperature\": 0.8\n      }\n    }\n  ]\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/api/template/:templateId",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "template",
                        ":templateId"
                    ],
                    "variable": [
                        {
                            "key": "templateId",
                            "value": "template-1768527344216-d5dd6a9c",
                            "description": "The unique template ID to update"
                        }
                    ]
                },
                "description": "Updates an existing workflow template."
            },
            "response": []
        },
        {
            "name": "5. Delete Template",
            "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/template/:templateId",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "template",
                        ":templateId"
                    ],
                    "variable": [
                        {
                            "key": "templateId",
                            "value": "template-1768527344216-d5dd6a9c",
                            "description": "The unique template ID to delete"
                        }
                    ]
                },
                "description": "Deletes a workflow template by ID."
            },
            "response": []
        },
        {
            "name": "6. Generate from Template",
            "request": {
                "method": "POST",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/api/template/:templateId/generate",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "api",
                        "template",
                        ":templateId",
                        "generate"
                    ],
                    "variable": [
                        {
                            "key": "templateId",
                            "value": "template-1768527344216-d5dd6a9c",
                            "description": "The template ID to execute"
                        }
                    ]
                },
                "description": "Executes a workflow from a template and generates the output."
            },
            "response": []
        }
    ]
}